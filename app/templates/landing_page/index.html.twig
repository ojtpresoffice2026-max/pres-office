{% extends 'base.html.twig' %}

{% block title %}PresOffice{% endblock %}

{% block body %}

<style>

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    padding:0;
    font-family:"Segoe UI",sans-serif;
    background:#F1F5F9;
    color:#334155;
    overflow-x:hidden;
}

/* ==========================
   SIDEBAR
========================== */

.sidebar{
    position:fixed;
    top:0;
    left:0;
    width:220px;
    height:100vh;
    background:#0F172A;
    display:flex;
    flex-direction:column;
    box-shadow:5px 0 20px rgba(0,0,0,.15);
    z-index:1000;
}

.logo{
    padding:28px 24px;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.logo h2{
    margin:0;
    font-size:20px;
    color:#fff;
    font-weight:700;
}

.sidebar ul{
    list-style:none;
    padding:18px 12px;
    margin:0;
}

.sidebar li{
    margin-bottom:8px;
}

.sidebar a{
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 14px;
    border-radius:10px;
    color:#CBD5E1;
    text-decoration:none;
    font-size:14px;
    transition:.25s;
}

.sidebar a:hover,
.sidebar a.active{
    background:#2563EB;
    color:#fff;
}

/* ==========================
   MAIN
========================== */

.main{
    margin-left:220px;
}

/* ==========================
   HERO
========================== */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:70px 0;
}

.hero h1{
    font-size:38px;
    font-weight:700;
    color:#0F172A;
    line-height:1.25;
}

.hero p{
    font-size:16px;
    color:#64748B;
    line-height:1.8;
    margin:20px 0 30px;
}

.hero img{
    width:100%;
    border-radius:18px;
    box-shadow:0 15px 35px rgba(0,0,0,.15);
}

/* ==========================
   BUTTONS
========================== */

.btn{
    border-radius:8px;
    padding:10px 22px;
    font-size:14px;
}

.btn-primary{
    background:#2563EB;
    border:none;
}

.btn-primary:hover{
    background:#1D4ED8;
}

.btn-outline-primary:hover{
    background:#2563EB;
}

/* ==========================
   SECTIONS
========================== */

section{
    padding:80px 0;
}

section h2{
    font-size:28px;
    font-weight:700;
    color:#0F172A;
}

/* ==========================
   FEATURE CARDS
========================== */

.feature-card{
    border:none;
    border-radius:18px;
    padding:30px;
    box-shadow:0 8px 25px rgba(0,0,0,.05);
    transition:.3s;
}

.feature-card:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 40px rgba(0,0,0,.12);
}

.feature-card i{
    font-size:40px;
}

.feature-card h4{
    font-size:18px;
    margin-top:18px;
}

.feature-card p{
    font-size:14px;
    color:#64748B;
}

/* ==========================
   ABOUT
========================== */

#about{
    background:#fff;
}

#about p{
    font-size:15px;
    line-height:1.8;
}

/* ==========================
   FOOTER
========================== */

footer{
    background:#0F172A;
}

footer h3{
    font-size:20px;
}

footer p{
    font-size:14px;
}

</style>

<div class="sidebar">

    <div class="logo">
        <h2>
            <i class="bi bi-folder-fill text-primary"></i>
            PresOffice
        </h2>
    </div>

    <ul>

        <li>
            <a href="#" class="active">
                <i class="bi bi-house-door-fill"></i>
                Home
            </a>
        </li>

        <li>
            <li href="#features">
                <i class="bi bi-grid-fill"></i>
                Features
            </li>
                <a> sent</a>
                <a> recieved</a>
                <a> file</a>
                <a> pending</a>
                <a> trace</a>
        </li>

        <li>
            <a href="#about">
                <i class="bi bi-info-circle-fill"></i>
                About
            </a>
        </li>

        <li>
            <a href="#contact">
                <i class="bi bi-envelope-fill"></i>
                Contact
            </a>
        </li>

    </ul>

</div>

<div class="main">

<section class="hero">

<div class="container-fluid px-5">

<div class="row align-items-center">

<div class="col-lg-6">

<h1>
Manage Documents<br>
Securely
</h1>

<p>
PresOffice is a secure document management platform that helps organizations
store, organize, search, and manage files efficiently.
</p>

<a href="#features" class="btn btn-primary me-2">
Explore
</a>

<a href="#about" class="btn btn-outline-primary">
Learn More
</a>

</div>

<div class="col-lg-6 text-center">

<img
src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=900"
class="img-fluid"
alt="Document Management">

</div>

</div>

</div>

</section>
<!-- ==========================
     FEATURES
========================== -->

<section id="features">

    <div class="container-fluid px-5">

        <div class="text-center mb-5">

            <h2>System Features</h2>

            <p class="text-muted">
                Everything you need to manage documents securely.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <i class="bi bi-cloud-arrow-up-fill text-primary"></i>

                    <h4>File Upload</h4>

                    <p>
                        Upload documents securely with support for multiple
                        file formats and large file sizes.
                    </p>

                </div>

            </div>

            <div class="col-lg-4 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <i class="bi bi-folder-fill text-warning"></i>

                    <h4>Organization</h4>

                    <p>
                        Organize files into folders and categories for quick
                        access and easy management.
                    </p>

                </div>

            </div>

            <div class="col-lg-4 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <i class="bi bi-search text-success"></i>

                    <h4>Advanced Search</h4>

                    <p>
                        Instantly locate documents using keywords,
                        categories, dates, or departments.
                    </p>

                </div>

            </div>

            <div class="col-lg-4 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <i class="bi bi-people-fill text-info"></i>

                    <h4>User Management</h4>

                    <p>
                        Manage administrators, staff, departments,
                        and permissions from one place.
                    </p>

                </div>

            </div>

            <div class="col-lg-4 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <i class="bi bi-clock-history text-danger"></i>

                    <h4>Activity Logs</h4>

                    <p>
                        Monitor user activities with complete
                        audit trails and document history.
                    </p>

                </div>

            </div>

            <div class="col-lg-4 col-md-6">

                <div class="card feature-card h-100 text-center">

                    <i class="bi bi-shield-lock-fill text-primary"></i>

                    <h4>Security</h4>

                    <p>
                        Secure every document using authentication,
                        encryption, and role-based access control.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ==========================
     ABOUT
========================== -->

<section id="about">

    <div class="container-fluid px-5">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <h2 class="mb-4">

                    About PresOffice

                </h2>

                <p>

                    PresOffice is an enterprise-level document management
                    platform developed to help organizations securely manage
                    digital files. It centralizes document storage,
                    improves collaboration, and simplifies file retrieval.

                </p>

                <p>

                    Designed for universities, businesses, and government
                    institutions, PresOffice enhances productivity through
                    role-based permissions, secure file storage, document
                    versioning, and comprehensive activity monitoring.

                </p>

            </div>

            <div class="col-lg-6 text-center">

                <i class="bi bi-folder-check display-1 text-primary"></i>

            </div>

        </div>

    </div>

</section>

<!-- ==========================
     FOOTER
========================== -->

<footer id="contact" class="text-white py-5">

    <div class="container-fluid px-5">

        <div class="row">

            <div class="col-md-4">

                <h3>PresOffice</h3>

                <p>
                    Professional File Management System
                </p>

            </div>

            <div class="col-md-4">

                <h5>Quick Links</h5>

                <p><a href="#" class="text-white text-decoration-none">Home</a></p>
                <p><a href="#features" class="text-white text-decoration-none">Features</a></p>
                <p><a href="#about" class="text-white text-decoration-none">About</a></p>

            </div>

            <div class="col-md-4">

                <h5>Contact</h5>

                <p>
                    <i class="bi bi-envelope-fill"></i>
                    support@presoffice.com
                </p>

                <p>
                    <i class="bi bi-telephone-fill"></i>
                    +63 912 345 6789
                </p>

            </div>

        </div>

        <hr class="border-secondary my-4">

        <div class="text-center">

            © {{ "now"|date("Y") }} PresOffice. All Rights Reserved.

        </div>

    </div>

</footer>

</div>

{% endblock %}