<!DOCTYPE html>
<html lang="en" data-theme="light">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

        <style>
:root{
    --navy:#0B1E3D;
    --navy-soft:#12294F;
    --blue:#1D4ED8;
    --blue-bright:#2563EB;
    --gold:#D4A017;
    --gold-soft:#F2C94C;

    --bg:#FFFFFF;
    --surface:#FFFFFF;
    --surface-2:#F0F3F9;
    --text:#1B2536;
    --text-muted:#5B6B85;
    --border:#E3E8F2;
    --sidebar-bg:#0B1E3D;
    --sidebar-text:#B9C4DC;
    --shadow:0 10px 30px rgba(15,30,60,.08);
    --shadow-lg:0 20px 45px rgba(15,30,60,.14);
    --radius:16px;
    --topbar-h:64px;
}

[data-theme="dark"]{
    --bg:#0A1220;
    --surface:#111B2E;
    --surface-2:#0E1728;
    --text:#E8ECF6;
    --text-muted:#93A1BD;
    --border:#1E2A42;
    --sidebar-bg:#070D1A;
    --sidebar-text:#8DA0C4;
    --shadow:0 10px 30px rgba(0,0,0,.35);
    --shadow-lg:0 25px 55px rgba(0,0,0,.5);
}

*{ box-sizing:border-box; }

body{
    margin:0;
    padding:0;
    font-family:"Inter",-apple-system,"Segoe UI",sans-serif;
    font-size:13px;
    line-height:1.5;
    background:var(--bg);
    color:var(--text);
    overflow-x:hidden;
    transition:background .35s ease,color .35s ease;
    min-height:100vh;
}

h1,h2,h3,h4,h5,.brand-font{
    font-family:"Poppins",sans-serif;
}

::selection{ background:var(--gold-soft); color:var(--navy); }

::-webkit-scrollbar{ width:10px; }
::-webkit-scrollbar-track{ background:var(--bg); }
::-webkit-scrollbar-thumb{ background:var(--border); border-radius:10px; }
::-webkit-scrollbar-thumb:hover{ background:var(--blue-bright); }

#preloader{
    position:fixed; inset:0; z-index:9999;
    background:var(--navy);
    display:flex; align-items:center; justify-content:center;
    transition:opacity .5s ease, visibility .5s ease;
}
#preloader.hide{ opacity:0; visibility:hidden; }
.preload-ring{
    width:52px; height:52px;
    border:4px solid rgba(255,255,255,.15);
    border-top-color:var(--gold);
    border-radius:50%;
    animation:spin .9s linear infinite;
}
@keyframes spin{ to{ transform:rotate(360deg); } }

.topbar{
    position:fixed;
    top:0; right:0; left:250px;
    height:var(--topbar-h);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 24px;
    z-index:1100;
    background:var(--surface);
    border-bottom:1px solid var(--border);
    transition:left .35s ease, background .35s ease;
}

.page-title-bar{
    display:flex;
    align-items:center;
    gap:10px;
}
.page-title-bar h4{
    margin:0;
    font-size:17px;
    font-weight:700;
    color:var(--text);
}
.page-title-bar .crumb{
    font-size:12px;
    color:var(--text-muted);
    font-weight:500;
}

.menu-toggle{
    display:none;
    width:40px; height:40px;
    border-radius:10px;
    background:var(--surface-2);
    border:1px solid var(--border);
    align-items:center;
    justify-content:center;
    color:var(--text);
    font-size:18px;
    cursor:pointer;
}

.topbar-right{ display:flex; align-items:center; gap:14px; }

.theme-toggle{
    width:52px;
    height:30px;
    border-radius:30px;
    background:var(--navy);
    border:1px solid var(--border);
    position:relative;
    cursor:pointer;
    display:flex;
    align-items:center;
    padding:3px;
    transition:.3s;
    flex-shrink:0;
}
.theme-toggle .knob{
    width:22px; height:22px;
    border-radius:50%;
    background:linear-gradient(145deg,var(--gold-soft),var(--gold));
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:12px;
    color:var(--navy);
    transform:translateX(0);
    transition:transform .35s cubic-bezier(.4,0,.2,1);
}
[data-theme="dark"] .theme-toggle .knob{ transform:translateX(22px); }

.sidebar{
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 100vh;

    background: var(--sidebar-bg);
    color: var(--sidebar-text);

    display: flex;
    flex-direction: column;

    border-right: 1px solid rgba(255,255,255,.08);

    z-index: 2000;

    transition:
        background .35s ease,
        color .35s ease,
        transform .35s ease;
}

.logo{
    padding:20px 22px;
    border-bottom:1px solid rgba(255,255,255,.08);
    display:flex;
    align-items:center;
    gap:12px;
    flex-shrink:0;
    height:var(--topbar-h);
}

.logo .seal{
    width:38px; height:38px;
    border-radius:50%;
    background:conic-gradient(from 180deg, var(--gold), var(--blue-bright), var(--gold));
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    box-shadow:0 0 0 2px rgba(255,255,255,.15);
}
.logo .seal i{ color:#fff; font-size:16px; }

.logo h2{
    font-size:16px;
    font-weight:700;
}

.logo span{
    display:block;
    font-size:10.5px;
    color:var(--sidebar-text);
    font-family:"Inter",sans-serif;
    font-weight:500;
    letter-spacing:.5px;
    text-transform:uppercase;
    margin-top:2px;
}

.sidebar-scroll{
    flex:1;
    overflow-y:auto;
    padding:14px 12px;
}

.sidebar ul{
    list-style:none;
    padding:0;
    margin:0;
}

.sidebar li{
    margin-bottom:3px;
}

.nav-item > a,
.nav-parent{
    display:flex;
    align-items:center;
    gap:12px;
    padding:11px 14px;
    border-radius:10px;
    color:var(--sidebar-text);
    text-decoration:none;
    font-size:14px;
    font-weight:500;
    transition:.2s;
    cursor:pointer;
    user-select:none;
}

.nav-parent i.chevron{
    margin-left:auto;
    font-size:12px;
    transition:transform .25s ease;
}
.nav-parent.open i.chevron{ transform:rotate(90deg); }

.nav-item > a i:first-child,
.nav-parent i:first-child{ font-size:16px; width:18px; text-align:center; }

.nav-item > a:hover,
.nav-parent:hover{
    background:rgba(255,255,255,.06);
    color:#fff;
}

.nav-item > a.active,
.nav-parent.active,
.sub-menu a.active{
    background:linear-gradient(135deg,var(--blue-bright),var(--blue));
    color:#fff;
    box-shadow:0 4px 14px rgba(37,99,235,.4);
}

.sub-menu{
    max-height:0;
    overflow:hidden;
    transition:max-height .3s ease;
}
.sub-menu.open{
    max-height:280px;
    overflow-y:auto;
}

.sub-menu a{
    display:flex;
    align-items:center;
    gap:10px;
    padding:9px 14px 9px 44px;
    font-size:13px;
    color:var(--sidebar-text);
    text-decoration:none;
    border-radius:8px;
    transition:.2s;
    cursor:pointer;
}
.sub-menu a:hover{
    background:rgba(255,255,255,.05);
    color:#fff;
}
.sub-menu a i{ font-size:6px; }

.sidebar-footer{
    padding:16px 22px 22px;
    border-top:1px solid rgba(255,255,255,.08);
    font-size:11.5px;
    color:rgba(185,196,220,.5);
    flex-shrink:0;
}

.sidebar-overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.5);
    z-index:1040;
    backdrop-filter:blur(2px);
}
.sidebar-overlay.show{ display:block; }

.main{
    margin-left:250px;
    padding-top:var(--topbar-h);
    min-height:100vh;
    transition:margin .35s ease;
}

.app-page{
    display:none;
    height:calc(100vh - var(--topbar-h));
    overflow-y:auto;
    animation:pageIn .35s ease;
}
.app-page.active{ display:block; }

@keyframes pageIn{
    from{ opacity:0; transform:translateY(10px); }
    to{ opacity:1; transform:translateY(0); }
}

.hero{
    padding:40px 0 10px;
    position:relative;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:var(--surface);
    border:1px solid var(--border);
    padding:7px 16px;
    border-radius:30px;
    font-size:12.5px;
    font-weight:600;
    color:var(--blue-bright);
    box-shadow:var(--shadow);
    margin-bottom:22px;
}
.eyebrow .dot{
    width:7px; height:7px; border-radius:50%;
    background:#22C55E;
    box-shadow:0 0 0 3px rgba(34,197,94,.25);
}

.hero h1{
    font-size:clamp(26px,3vw,36px);
    font-weight:800;
    color:var(--text);
    line-height:1.2;
    letter-spacing:-.5px;
}

.hero h1 .accent{
    background:linear-gradient(100deg,var(--blue-bright),var(--gold));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
}

.hero p{
    font-size:15.5px;
    color:var(--text-muted);
    line-height:1.75;
    margin:16px 0 0;
    max-width:620px;
}

.hero-stats{
    display:flex;
    gap:30px;
    margin-top:28px;
    flex-wrap:wrap;
}
.hero-stats .stat h3{
    font-size:20px;
}

.hero-stats .stat span{
    font-size:11px;
}

.stat-mini .num{
    font-size:18px;
}

.stat-mini .lbl{
    font-size:11px;
}

.btn{
    border-radius:10px;
    padding:12px 26px;
    font-size:14.5px;
    font-weight:600;
    transition:.25s;
    border:none;
}
.btn-primary{
    background:linear-gradient(135deg,var(--blue-bright),var(--blue));
    box-shadow:0 8px 20px rgba(37,99,235,.35);
}
.btn-primary:hover{
    transform:translateY(-2px);
    box-shadow:0 12px 26px rgba(37,99,235,.45);
    background:linear-gradient(135deg,var(--blue),var(--blue-bright));
}
.btn-outline-primary{
    border:1.5px solid var(--border);
    color:var(--text);
    background:var(--surface);
}
.btn-outline-primary:hover{
    background:var(--surface-2);
    border-color:var(--blue-bright);
    color:var(--blue-bright);
    transform:translateY(-2px);
}

.page-section{ padding:32px 0; position:relative; }

.section-tag{
    display:inline-block;
    font-size:12px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:var(--gold);
    background:rgba(212,160,23,.12);
    padding:6px 14px;
    border-radius:20px;
    margin-bottom:14px;
}

.page-section h2{
    font-size:24px;
}

.dash-card h5{
    font-size:14px;
}

.dash-card .dash-sub{
    font-size:11px;
}

.dash-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:11px;
    font-weight:700;
    letter-spacing:.5px;
    text-transform:uppercase;
    color:var(--gold);
    background:rgba(212,160,23,.12);
    padding:4px 10px;
    border-radius:20px;
    margin-left:10px;
    vertical-align:middle;
}

.dash-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:26px;
    box-shadow:var(--shadow);
    height:100%;
}
.dash-card h5{ font-size:15px; font-weight:700; color:var(--text); margin-bottom:4px; }
.dash-card .dash-sub{ font-size:12.5px; color:var(--text-muted); margin-bottom:18px; }

.chart-wrap{ position:relative; height:230px; }

.chart-legend{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
    margin-top:18px;
    justify-content:center;
}
.chart-legend .item{ display:flex; align-items:center; gap:7px; font-size:12.5px; color:var(--text-muted); }
.chart-legend .dot{ width:9px; height:9px; border-radius:50%; flex-shrink:0; }

.stat-mini-row{ display:flex; gap:14px; flex-wrap:wrap; }
.stat-mini{
    flex:1;
    min-width:120px;
    background:var(--surface-2);
    border:1px solid var(--border);
    border-radius:12px;
    padding:16px;
}
.stat-mini .num{ font-size:22px; font-weight:800; color:var(--text); display:flex; align-items:center; gap:6px; }
.stat-mini .lbl{ font-size:11.5px; color:var(--text-muted); margin-top:2px; }
.stat-mini i{ font-size:16px; }

.table-wrap{ overflow-x:auto; }
table.log-table{ width:100%; border-collapse:collapse; font-size:13.5px; }
table.log-table th{
    text-align:left;
    padding:10px 14px;
    color:var(--text-muted);
    font-weight:600;
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:.4px;
    border-bottom:1px solid var(--border);
    white-space:nowrap;
}
table.log-table td{
    padding:12px 14px;
    border-bottom:1px solid var(--border);
    color:var(--text);
    white-space:nowrap;
}
table.log-table tr:last-child td{ border-bottom:none; }
table.log-table tr:hover td{ background:var(--surface-2); }

.status-pill{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:4px 10px;
    border-radius:20px;
    font-size:11.5px;
    font-weight:600;
}
.status-pill.received{ background:rgba(37,99,235,.12); color:var(--blue-bright); }
.status-pill.pending{ background:rgba(212,160,23,.15); color:var(--gold); }
.status-pill.approved{ background:rgba(34,197,94,.12); color:#22C55E; }
.status-pill.forwarded{ background:rgba(139,92,246,.12); color:#8B5CF6; }

.placeholder-note{
    display:flex;
    align-items:center;
    gap:10px;
    background:rgba(212,160,23,.1);
    border:1px dashed var(--gold);
    border-radius:12px;
    padding:12px 16px;
    font-size:12.5px;
    color:var(--text-muted);
    margin-top:24px;
}
.placeholder-note i{ color:var(--gold); font-size:16px; flex-shrink:0; }

.quick-actions{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    margin-top:10px;
}
.quick-actions a{
    display:flex;
    align-items:center;
    gap:8px;
    padding:10px 18px;
    border-radius:10px;
    background:var(--surface);
    border:1px solid var(--border);
    color:var(--text);
    text-decoration:none;
    font-size:13.5px;
    font-weight:600;
    transition:.2s;
    cursor:pointer;
}
.quick-actions a:hover{
    border-color:var(--blue-bright);
    color:var(--blue-bright);
    transform:translateY(-2px);
    box-shadow:var(--shadow);
}
.quick-actions a i{ color:var(--blue-bright); }

.placeholder-card{
    background:var(--surface);
    border:1px dashed var(--border);
    border-radius:var(--radius);
    padding:40px;
    text-align:center;
    color:var(--text-muted);
}
.placeholder-card i{
    font-size:38px;
    color:var(--blue-bright);
    margin-bottom:14px;
    display:block;
}
.placeholder-card h4{
    color:var(--text);
    font-size:17px;
    font-weight:700;
    margin-bottom:8px;
}
.placeholder-card p{ font-size:13.5px; margin:0; }

.sub-page-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(220px,1fr));
    gap:16px;
    margin-top:24px;
}
.sub-page-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:14px;
    padding:22px;
    transition:.25s;
}
.sub-page-card:hover{
    transform:translateY(-4px);
    box-shadow:var(--shadow);
    border-color:transparent;
}
.sub-page-card i{ font-size:26px; color:var(--blue-bright); margin-bottom:10px; display:block; }
.sub-page-card h5{ font-size:14.5px; font-weight:700; color:var(--text); margin-bottom:4px; }
.sub-page-card span{ font-size:12px; color:var(--text-muted); }

#page-about p{ font-size:15.5px; line-height:1.9; color:var(--text-muted); }

.about-visual{ position:relative; display:flex; align-items:center; justify-content:center; }
.about-seal{
    width:200px; height:200px;
    border-radius:50%;
    background:linear-gradient(145deg,var(--navy),var(--navy-soft));
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 25px 60px rgba(11,30,61,.35);
    position:relative;
}
.about-seal::before{
    content:"";
    position:absolute; inset:10px;
    border-radius:50%;
    border:2px dashed rgba(212,160,23,.5);
}
.about-seal i{
    font-size:58px;
    background:linear-gradient(135deg,var(--gold-soft),var(--gold));
    -webkit-background-clip:text; background-clip:text; color:transparent;
}

.about-checklist{ list-style:none; padding:0; margin:24px 0 0; }
.about-checklist li{ display:flex; align-items:flex-start; gap:10px; margin-bottom:12px; font-size:14.5px; color:var(--text-muted); }
.about-checklist i{ color:#22C55E; margin-top:2px; }

.contact-card{
    background:var(--navy);
    color:#C6D1E8;
    border-radius:var(--radius);
    padding:36px;
}
.contact-card h3{ font-size:20px; color:#fff; font-weight:700; }
.contact-card h5{ color:#fff; font-size:14.5px; font-weight:600; margin-bottom:16px; }
.contact-card p, .contact-card a{ font-size:14px; color:#B9C4DC; }
.contact-card a{ text-decoration:none; transition:.2s; }
.contact-card a:hover{ color:var(--gold-soft); padding-left:3px; }

.footer-social a{
    display:inline-flex; align-items:center; justify-content:center;
    width:38px; height:38px; border-radius:10px;
    background:rgba(255,255,255,.06);
    margin-right:8px;
    color:#fff !important;
}
.footer-social a:hover{ background:var(--blue-bright); transform:translateY(-3px); }

@media (max-width:991px){
    .sidebar{ transform:translateX(-100%); }
    .sidebar.open{ transform:translateX(0); }
    .main{ margin-left:0; }
    .topbar{ left:0; }
    .menu-toggle{ display:flex; }
}

@media (max-width:575px){
    .hero h1{ font-size:26px; }
    .page-section{ padding:24px 0; }
}
        </style>

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <div id="preloader"><div class="preload-ring"></div></div>

        <div class="topbar">
            <div class="page-title-bar">
                <div class="menu-toggle" id="menuToggle"><i class="bi bi-list"></i></div>
                <div>
                    <h4 id="pageTitleText">{% block page_title %}Home{% endblock %}</h4>
                    <div class="crumb" id="pageCrumbText">{% block page_crumb %}Overview{% endblock %}</div>
                </div>
            </div>
            <div class="topbar-right">
                <div class="theme-toggle" id="themeToggle" title="Toggle dark mode">
                    <div class="knob"><i class="bi bi-sun-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="sidebar" id="sidebar">

            <div class="logo">
                <div class="seal"><i class="bi bi-mortarboard-fill"></i></div>
                <div>
                    <h2>PresOffice</h2>
                    <span>NORSU · President's Office</span>
                </div>
            </div>

            <div class="sidebar-scroll">
                <ul>

                    <li class="nav-item">
                        <a class="nav-link active" data-page="home" data-title="Home" data-crumb="Overview">
                            <i class="bi bi-house-door-fill"></i> Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" data-page="activity-logs" data-title="Activity Logs" data-crumb="Audit trail">
                            <i class="bi bi-clock-history"></i> Activity Logs
                        </a>
                    </li>

                    <li>
                        <div class="nav-parent" data-target="menu-receiving">
                            <i class="bi bi-box-arrow-in-down"></i> Receiving <i class="bi bi-chevron-right chevron"></i>
                        </div>
                        <div class="sub-menu" id="menu-receiving">
