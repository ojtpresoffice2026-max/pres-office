        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
document.addEventListener('DOMContentLoaded', function() {
    var preloader = document.getElementById('preloader');

    function showPreloader() {
        if (preloader) {
            preloader.classList.remove('hide');
        }
    }

    function hidePreloader() {
        if (preloader) {
            preloader.classList.add('hide');
        }
    }

    window.addEventListener('load', function() {
        setTimeout(hidePreloader, 250);
    });

    document.addEventListener('click', function(event) {
        var clickedElement = event.target && event.target.closest ? event.target.closest('a[href]') : null;
        if (!clickedElement) {
            return;
        }

        var href = clickedElement.getAttribute('href') || '';
        var isExternal = /^https?:\/\//i.test(href);
        var isSpecial = href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:');

        if (!isExternal && !isSpecial && clickedElement.getAttribute('target') !== '_blank') {
            showPreloader();
        }
    });

    document.addEventListener('turbo:before-visit', showPreloader);
    document.addEventListener('turbo:load', hidePreloader);
    document.addEventListener('turbo:render', hidePreloader);
    document.addEventListener('turbo:frame-load', hidePreloader);

    [document.getElementById('year'), document.getElementById('year2')].forEach(function(el) {
        if (el) {
            el.textContent = new Date().getFullYear();
        }
    });

    var root = document.documentElement;
    var toggle = document.getElementById('themeToggle');
    var knobIcon = toggle ? toggle.querySelector('.knob i') : null;
    var saved = localStorage.getItem('presoffice-theme');
    var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (toggle && knobIcon) {
        setTheme(saved || (systemDark ? 'dark' : 'light'));

        toggle.addEventListener('click', function() {
            var current = root.getAttribute('data-theme');
            setTheme(current === 'dark' ? 'light' : 'dark');
        });
    }

    function setTheme(mode) {
        root.setAttribute('data-theme', mode);
        localStorage.setItem('presoffice-theme', mode);
        if (knobIcon) {
            knobIcon.className = mode === 'dark' ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
        }
    }

    var sidebar = document.getElementById('sidebar');
    var menuToggle = document.getElementById('menuToggle');
    var overlay = document.getElementById('sidebarOverlay');

    if (menuToggle && sidebar) {
        menuToggle.addEventListener('click', function() {
            sidebar.classList.add('open');
            if (overlay) { overlay.classList.add('show'); }
        });
    }

    if (overlay) {
        overlay.addEventListener('click', closeSidebar);
    }

    function closeSidebar() {
        if (sidebar) { sidebar.classList.remove('open'); }
        if (overlay) { overlay.classList.remove('show'); }
    }

    document.querySelectorAll('.sidebar a').forEach(function(a) {
        a.addEventListener('click', closeSidebar);
    });

    document.querySelectorAll('.nav-parent').forEach(function(parent) {
        parent.addEventListener('click', function() {
            var subMenu = document.getElementById(parent.dataset.target);
            var isOpen = subMenu && subMenu.classList.contains('open');

            document.querySelectorAll('.sub-menu.open').forEach(function(el) {
                if (el !== subMenu) { el.classList.remove('open'); }
            });
            document.querySelectorAll('.nav-parent.open').forEach(function(el) {
                if (el !== parent) { el.classList.remove('open'); }
            });

            if (subMenu) { subMenu.classList.toggle('open', !isOpen); }
            parent.classList.toggle('open', !isOpen);
        });
    });

    function normalizePath(path) {
        if (!path || path === '/') {
            return '/';
        }

        return path.replace(/\/+$/, '');
    }

    function getLinkPath(link) {
        var href = link.getAttribute('href');
        if (!href || href.startsWith('#')) {
            return null;
        }

        try {
            return normalizePath(new URL(href, window.location.origin).pathname);
        } catch (error) {
            return normalizePath(href);
        }
    }

    function isActiveLink(link) {
        var linkPath = getLinkPath(link);
        var currentPath = normalizePath(window.location.pathname);

        if (!linkPath || linkPath === '/') {
            return currentPath === '/';
        }

        return currentPath === linkPath || (currentPath.startsWith(linkPath + '/') && linkPath !== '/');
    }

    function syncSidebarState() {
        var activeMatch = null;

        document.querySelectorAll('.sidebar .nav-link, .sidebar .sub-menu a').forEach(function(link) {
            link.classList.remove('active');
        });

        document.querySelectorAll('.sidebar .sub-menu').forEach(function(subMenu) {
            subMenu.classList.remove('open');
        });

        document.querySelectorAll('.sidebar .nav-parent').forEach(function(parent) {
            parent.classList.remove('open');
        });

        if (normalizePath(window.location.pathname) === '/') {
            var homeLink = document.querySelector('.sidebar .nav-item > .nav-link[data-page="home"], .sidebar .nav-item > .nav-link[href="/"]');
            if (homeLink) {
                homeLink.classList.add('active');
            }
            return;
        }

        document.querySelectorAll('.sidebar .sub-menu a').forEach(function(link) {
            if (isActiveLink(link)) {
                activeMatch = link;
                link.classList.add('active');

                var subMenu = link.closest('.sub-menu');
                if (subMenu) {
                    subMenu.classList.add('open');
                    var parentToggle = document.querySelector('.sidebar .nav-parent[data-target="' + subMenu.id + '"]');
                    if (parentToggle) {
                        parentToggle.classList.add('open');
                    }
                }
            }
        });

        if (!activeMatch) {
            document.querySelectorAll('.sidebar .nav-item > .nav-link').forEach(function(link) {
                if (isActiveLink(link)) {
                    link.classList.add('active');
                    activeMatch = link;
                }
            });
        }

        if (!activeMatch) {
            var homeLink = document.querySelector('.sidebar .nav-item > .nav-link[data-page="home"], .sidebar .nav-item > .nav-link[href="/"]');
            if (homeLink) {
                homeLink.classList.add('active');
            }
        }
    }

    syncSidebarState();
    window.addEventListener('load', syncSidebarState);
    document.addEventListener('turbo:load', syncSidebarState);
    document.addEventListener('turbo:render', syncSidebarState);
    document.addEventListener('turbo:frame-load', syncSidebarState);
});
        </script>
