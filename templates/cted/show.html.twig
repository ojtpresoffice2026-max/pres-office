{% extends 'base.html.twig' %}

{% block title %}Cted{% endblock %}

{% block body %}
    <h1>Cted</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cted.id }}</td>
            </tr>
            <tr>
                <th>No_of_comm</th>
                <td>{{ cted.noOfComm }}</td>
            </tr>
            <tr>
                <th>Document_code</th>
                <td>{{ cted.documentCode }}</td>
            </tr>
            <tr>
                <th>Bearer_of_letter</th>
                <td>{{ cted.bearerOfLetter }}</td>
            </tr>
            <tr>
                <th>Date_receive</th>
                <td>{{ cted.dateReceive ? cted.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Time_receive</th>
                <td>{{ cted.timeReceive }}</td>
            </tr>
            <tr>
                <th>Receiving_staff</th>
                <td>{{ cted.receivingStaff }}</td>
            </tr>
            <tr>
                <th>Letter_sender</th>
                <td>{{ cted.letterSender }}</td>
            </tr>
            <tr>
                <th>Office_designation</th>
                <td>{{ cted.officeDesignation }}</td>
            </tr>
            <tr>
                <th>Date_of_the_letter</th>
                <td>{{ cted.dateOfTheLetter ? cted.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Content_of_the_letter</th>
                <td>{{ cted.contentOfTheLetter }}</td>
            </tr>
            <tr>
                <th>Other_note</th>
                <td>{{ cted.otherNote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cted_index') }}">back to list</a>

    <a href="{{ path('app_cted_edit', {'id': cted.id}) }}">edit</a>

    {{ include('cted/_delete_form.html.twig') }}
{% endblock %}
