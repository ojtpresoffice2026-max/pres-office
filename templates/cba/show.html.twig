{% extends 'base.html.twig' %}

{% block title %}Cba{% endblock %}

{% block body %}
    <h1>Cba</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cba.id }}</td>
            </tr>
            <tr>
                <th>No_of_comm</th>
                <td>{{ cba.noOfComm }}</td>
            </tr>
            <tr>
                <th>Document_code</th>
                <td>{{ cba.documentCode }}</td>
            </tr>
            <tr>
                <th>Bearer_of_letter</th>
                <td>{{ cba.bearerOfLetter }}</td>
            </tr>
            <tr>
                <th>Date_receive</th>
                <td>{{ cba.dateReceive ? cba.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Time_receive</th>
                <td>{{ cba.timeReceive }}</td>
            </tr>
            <tr>
                <th>Receiving_staff</th>
                <td>{{ cba.receivingStaff }}</td>
            </tr>
            <tr>
                <th>Letter_sender</th>
                <td>{{ cba.letterSender }}</td>
            </tr>
            <tr>
                <th>Office_designation</th>
                <td>{{ cba.officeDesignation }}</td>
            </tr>
            <tr>
                <th>Date_of_the_letter</th>
                <td>{{ cba.dateOfTheLetter ? cba.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Content_of_the_letter</th>
                <td>{{ cba.contentOfTheLetter }}</td>
            </tr>
            <tr>
                <th>Other_note</th>
                <td>{{ cba.otherNote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cba_index') }}">back to list</a>

    <a href="{{ path('app_cba_edit', {'id': cba.id}) }}">edit</a>

    {{ include('cba/_delete_form.html.twig') }}
{% endblock %}
