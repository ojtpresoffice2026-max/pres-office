{% extends 'base.html.twig' %}

{% block title %}Cas index{% endblock %}

{% block body %}
    <h1>Cas index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>No_of_comm</th>
                <th>Document_code</th>
                <th>Bearer_of_letter</th>
                <th>Date_receive</th>
                <th>Time_receive</th>
                <th>Receiving_staff</th>
                <th>Letter_sender</th>
                <th>Office_designation</th>
                <th>Date_of_the_letter</th>
                <th>Content_of_the_letter</th>
                <th>Other_note</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ca in cas %}
            <tr>
                <td>{{ ca.id }}</td>
                <td>{{ ca.noOfComm }}</td>
                <td>{{ ca.documentCode }}</td>
                <td>{{ ca.bearerOfLetter }}</td>
                <td>{{ ca.dateReceive ? ca.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ca.timeReceive }}</td>
                <td>{{ ca.receivingStaff }}</td>
                <td>{{ ca.letterSender }}</td>
                <td>{{ ca.officeDesignation }}</td>
                <td>{{ ca.dateOfTheLetter ? ca.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ca.contentOfTheLetter }}</td>
                <td>{{ ca.otherNote }}</td>
                <td>
                    <a href="{{ path('app_cas_show', {'id': ca.id}) }}">show</a>
                    <a href="{{ path('app_cas_edit', {'id': ca.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cas_new') }}">Create new</a>
{% endblock %}
