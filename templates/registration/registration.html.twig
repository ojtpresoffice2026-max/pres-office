{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

<style>
body{
    background:#FFFFFF;
    font-family:"Inter",-apple-system,"Segoe UI",sans-serif;
}

.register-wrapper{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px 20px;
}

.register-card{
    width:100%;
    max-width:950px;
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 20px 50px rgba(0,0,0,.08);
}

.register-left{
    background:linear-gradient(135deg,#0B1E3D,#1D4ED8);
    color:#fff;
    padding:60px 45px;
}

.register-left h2{
    font-weight:700;
    margin-bottom:15px;
}

.register-left p{
    color:rgba(255,255,255,.85);
    line-height:1.8;
}

.register-left ul{
    list-style:none;
    padding:0;
    margin-top:30px;
}

.register-left li{
    margin-bottom:15px;
}

.register-left i{
    color:#F2C94C;
    margin-right:10px;
}

.register-right{
    padding:60px 45px;
}

.register-right h3{
    color:#0B1E3D;
    font-weight:700;
}

.register-right p{
    color:#6c757d;
}

.form-label{
    font-weight:600;
}

.form-control{
    border-radius:10px;
    padding:12px;
}

.form-control:focus{
    border-color:#2563EB;
    box-shadow:0 0 0 .2rem rgba(37,99,235,.15);
}

.btn-register{
    background:#2563EB;
    color:#fff;
    border:none;
    padding:12px;
    border-radius:10px;
    width:100%;
    font-weight:600;
}

.btn-register:hover{
    background:#1D4ED8;
}

.login-link{
    margin-top:25px;
    text-align:center;
}

.alert{
    margin-bottom:20px;
}

@media(max-width:991px){

    .register-left{
        display:none;
    }

    .register-right{
        padding:40px 30px;
    }

}
</style>

<div class="register-wrapper">

    <div class="register-card">

        <div class="row g-0">

            <div class="col-lg-6 register-left">

                <i class="bi bi-folder-fill display-3 mb-4"></i>

                <h2>PresOffice</h2>

                <p>
                    Official Document Management System of the
                    NORSU President's Office.
                </p>

                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Secure document storage</li>
                    <li><i class="bi bi-check-circle-fill"></i> Fast document indexing</li>
                    <li><i class="bi bi-check-circle-fill"></i> Role-based user access</li>
                </ul>

            </div>

            <div class="col-lg-6 register-right">

                <h3>Create Account</h3>

                <p class="mb-4">
                    Register to access PresOffice.
                </p>

                {% for flash_error in app.flashes('error') %}
                    <div class="alert alert-danger">
                        {{ flash_error }}
                    </div>
                {% endfor %}

                {{ form_start(registrationForm) }}

                    <div class="mb-3">
                        {{ form_label(registrationForm.username) }}
                        {{ form_widget(registrationForm.username,{
                            attr:{
                                class:'form-control',
                                placeholder:'Enter username'
                            }
                        }) }}
                        {{ form_errors(registrationForm.username) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(registrationForm.plainPassword) }}
                        {{ form_widget(registrationForm.plainPassword,{
                            attr:{
                                class:'form-control',
                                placeholder:'Enter password'
                            }
                        }) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <button class="btn-register">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Register
                    </button>

                {{ form_end(registrationForm) }}

                <div class="login-link">
                    Already have an account?
                    <a href="{{ path('app_login') }}">
                        Login here
                    </a>
                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %} 