{% extends 'base.html.twig' %}

{% block title %}Cit{% endblock %}

{% block body %}
    <h1>Cit</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cit.id }}</td>
            </tr>
            <tr>
                <th>No_of_comm</th>
                <td>{{ cit.noOfComm }}</td>
            </tr>
            <tr>
                <th>Document_code</th>
                <td>{{ cit.documentCode }}</td>
            </tr>
            <tr>
                <th>Bearer_of_letter</th>
                <td>{{ cit.bearerOfLetter }}</td>
            </tr>
            <tr>
                <th>Date_receive</th>
                <td>{{ cit.dateReceive ? cit.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Time_receive</th>
                <td>{{ cit.timeReceive }}</td>
            </tr>
            <tr>
                <th>Receiving_staff</th>
                <td>{{ cit.receivingStaff }}</td>
            </tr>
            <tr>
                <th>Letter_sender</th>
                <td>{{ cit.letterSender }}</td>
            </tr>
            <tr>
                <th>Office_designation</th>
                <td>{{ cit.officeDesignation }}</td>
            </tr>
            <tr>
                <th>Date_of_the_letter</th>
                <td>{{ cit.dateOfTheLetter ? cit.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Content_of_the_letter</th>
                <td>{{ cit.contentOfTheLetter }}</td>
            </tr>
            <tr>
                <th>Other_note</th>
                <td>{{ cit.otherNote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cit_index') }}">back to list</a>

    <a href="{{ path('app_cit_edit', {'id': cit.id}) }}">edit</a>

    {{ include('cit/_delete_form.html.twig') }}
{% endblock %}
