{% extends 'base.html.twig' %}

{% block title %}Cit index{% endblock %}

{% block body %}
    <h1>Cit index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>No_of_comm</th>
                <th>Document_code</th>
                <th>Bearer_of_letter</th>
                <th>Date_receive</th>
                <th>Time_receive</th>
                <th>Receiving_staff</th>
                <th>Letter_sender</th>
                <th>Office_designation</th>
                <th>Date_of_the_letter</th>
                <th>Content_of_the_letter</th>
                <th>Other_note</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cit in cits %}
            <tr>
                <td>{{ cit.id }}</td>
                <td>{{ cit.noOfComm }}</td>
                <td>{{ cit.documentCode }}</td>
                <td>{{ cit.bearerOfLetter }}</td>
                <td>{{ cit.dateReceive ? cit.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ cit.timeReceive }}</td>
                <td>{{ cit.receivingStaff }}</td>
                <td>{{ cit.letterSender }}</td>
                <td>{{ cit.officeDesignation }}</td>
                <td>{{ cit.dateOfTheLetter ? cit.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ cit.contentOfTheLetter }}</td>
                <td>{{ cit.otherNote }}</td>
                <td>
                    <a href="{{ path('app_cit_show', {'id': cit.id}) }}">show</a>
                    <a href="{{ path('app_cit_edit', {'id': cit.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cit_new') }}">Create new</a>
{% endblock %}
