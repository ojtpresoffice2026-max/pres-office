<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function(){

    window.addEventListener('load', function(){
        var pre = document.getElementById('preloader');
        setTimeout(function(){ pre.classList.add('hide'); }, 250);
    });

    document.getElementById('year').textContent = new Date().getFullYear();
    document.getElementById('year2').textContent = new Date().getFullYear();

    /* THEME TOGGLE */
    var root = document.documentElement;
    var toggle = document.getElementById('themeToggle');
    var knobIcon = toggle.querySelector('.knob i');
    var saved = localStorage.getItem('presoffice-theme');
    var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    setTheme(saved || (systemDark ? 'dark' : 'light'));

    toggle.addEventListener('click', function(){
        var current = root.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
    });
    function setTheme(mode){
        root.setAttribute('data-theme', mode);
        localStorage.setItem('presoffice-theme', mode);
        knobIcon.className = mode === 'dark' ? 'bi bi-moon-stars-fill' : 'bi bi-sun-fill';
    }

    /* MOBILE SIDEBAR */
    var sidebar = document.getElementById('sidebar');
    var menuToggle = document.getElementById('menuToggle');
    var overlay = document.getElementById('sidebarOverlay');
    menuToggle.addEventListener('click', function(){
        sidebar.classList.add('open');
        overlay.classList.add('show');
    });
    overlay.addEventListener('click', closeSidebar);
    function closeSidebar(){
        sidebar.classList.remove('open');
        overlay.classList.remove('show');
    }

    /* EXPANDABLE NAV PARENTS (accordion) */
    document.querySelectorAll('.nav-parent').forEach(function(parent){
        parent.addEventListener('click', function(){
            var subMenu = document.getElementById(parent.dataset.target);
            var isOpen = subMenu.classList.contains('open');

            document.querySelectorAll('.sub-menu.open').forEach(function(el){
                if(el !== subMenu) el.classList.remove('open');
            });
            document.querySelectorAll('.nav-parent.open').forEach(function(el){
                if(el !== parent) el.classList.remove('open');
            });

            subMenu.classList.toggle('open', !isOpen);
            parent.classList.toggle('open', !isOpen);
        });
    });

    /* ===== PAGE SWITCHING (locked single-view app shell) ===== */
    var pages = document.querySelectorAll('.app-page');
    var navLinks = document.querySelectorAll('[data-page]');
    var titleEl = document.getElementById('pageTitleText');
    var crumbEl = document.getElementById('pageCrumbText');

    function goToPage(pageId, title, crumb, sourceLink){
        pages.forEach(function(p){
            p.classList.toggle('active', p.id === 'page-' + pageId);
        });
        if(pageId === 'home' || pageId === 'about' || pageId === 'contact' || pageId === 'activity-logs'){
            document.querySelectorAll('.nav-item > .nav-link').forEach(function(l){
                l.classList.toggle('active', l.dataset.page === pageId);
            });
            document.querySelectorAll('.sub-menu a').forEach(function(l){ l.classList.remove('active'); });
        } else {
            document.querySelectorAll('.nav-item > .nav-link').forEach(function(l){ l.classList.remove('active'); });
            document.querySelectorAll('.sub-menu a').forEach(function(l){
                l.classList.toggle('active', l === sourceLink);
            });
            // keep the relevant submenu expanded so the user sees where they are
            if(sourceLink){
                var subMenu = sourceLink.closest('.sub-menu');
                if(subMenu){
                    document.querySelectorAll('.sub-menu.open').forEach(function(el){
                        if(el !== subMenu) el.classList.remove('open');
                    });
                    document.querySelectorAll('.nav-parent.open').forEach(function(el){ el.classList.remove('open'); });
                    subMenu.classList.add('open');
                    var parentToggle = document.querySelector('.nav-parent[data-target="' + subMenu.id + '"]');
                    if(parentToggle) parentToggle.classList.add('open');
                }
            }
        }
        titleEl.textContent = title || pageId;
        crumbEl.textContent = crumb || '';
        // reset scroll position of the freshly-opened page
        var activePage = document.getElementById('page-' + pageId);
        if(activePage) activePage.scrollTop = 0;
        closeSidebar();
    }

    navLinks.forEach(function(link){
        link.addEventListener('click', function(e){
            e.preventDefault();
            goToPage(link.dataset.page, link.dataset.title, link.dataset.crumb, link);
        });
    });

    /* DASHBOARD PIE CHART */
    var pieCanvas = document.getElementById('statusPieChart');
    if(pieCanvas && window.Chart){
        new Chart(pieCanvas, {
            type: 'doughnut',
            data: {
                labels: ['Received', 'Pending', 'Approved', 'Forwarded'],
                datasets: [{
                    data: [128, 34, 81, 13],
                    backgroundColor: ['#2563EB', '#D4A017', '#22C55E', '#8B5CF6'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: { legend: { display: false } }
            }
        });
    }

});
</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
