{% extends 'base.html.twig' %}

{% block title %}Col index{% endblock %}

{% block body %}
    <h1>Col index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>No_of_comm</th>
                <th>Document_code</th>
                <th>Bearer_of_letter</th>
                <th>Date_receive</th>
                <th>Time_receive</th>
                <th>Receiving_staff</th>
                <th>Letter_sender</th>
                <th>Office_designation</th>
                <th>Date_of_the_letter</th>
                <th>Content_of_the_letter</th>
                <th>Other_note</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for col in cols %}
            <tr>
                <td>{{ col.id }}</td>
                <td>{{ col.noOfComm }}</td>
                <td>{{ col.documentCode }}</td>
                <td>{{ col.bearerOfLetter }}</td>
                <td>{{ col.dateReceive ? col.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ col.timeReceive }}</td>
                <td>{{ col.receivingStaff }}</td>
                <td>{{ col.letterSender }}</td>
                <td>{{ col.officeDesignation }}</td>
                <td>{{ col.dateOfTheLetter ? col.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ col.contentOfTheLetter }}</td>
                <td>{{ col.otherNote }}</td>
                <td>
                    <a href="{{ path('app_col_show', {'id': col.id}) }}">show</a>
                    <a href="{{ path('app_col_edit', {'id': col.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_col_new') }}">Create new</a>
{% endblock %}
