{% extends 'base.html.twig' %}

{% block title %}Cea index{% endblock %}

{% block body %}
    <h1>Cea index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>No_of_comm</th>
                <th>Document_code</th>
                <th>Bearer_of_letter</th>
                <th>Date_receive</th>
                <th>Time_receive</th>
                <th>Receiving_staff</th>
                <th>Letter_sender</th>
                <th>Office_designation</th>
                <th>Date_of_the_letter</th>
                <th>Content_of_the_letter</th>
                <th>Other_note</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cea in ceas %}
            <tr>
                <td>{{ cea.id }}</td>
                <td>{{ cea.noOfComm }}</td>
                <td>{{ cea.documentCode }}</td>
                <td>{{ cea.bearerOfLetter }}</td>
                <td>{{ cea.dateReceive ? cea.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ cea.timeReceive }}</td>
                <td>{{ cea.receivingStaff }}</td>
                <td>{{ cea.letterSender }}</td>
                <td>{{ cea.officeDesignation }}</td>
                <td>{{ cea.dateOfTheLetter ? cea.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ cea.contentOfTheLetter }}</td>
                <td>{{ cea.otherNote }}</td>
                <td>
                    <a href="{{ path('app_cea_show', {'id': cea.id}) }}">show</a>
                    <a href="{{ path('app_cea_edit', {'id': cea.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="13">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cea_new') }}">Create new</a>
{% endblock %}
