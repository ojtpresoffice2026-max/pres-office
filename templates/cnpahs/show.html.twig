{% extends 'base.html.twig' %}

{% block title %}Cnpahs{% endblock %}

{% block body %}
    <h1>Cnpahs</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cnpah.id }}</td>
            </tr>
            <tr>
                <th>No_of_comm</th>
                <td>{{ cnpah.noOfComm }}</td>
            </tr>
            <tr>
                <th>Document_code</th>
                <td>{{ cnpah.documentCode }}</td>
            </tr>
            <tr>
                <th>Bearer_of_letter</th>
                <td>{{ cnpah.bearerOfLetter }}</td>
            </tr>
            <tr>
                <th>Date_receive</th>
                <td>{{ cnpah.dateReceive ? cnpah.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Time_receive</th>
                <td>{{ cnpah.timeReceive }}</td>
            </tr>
            <tr>
                <th>Receiving_staff</th>
                <td>{{ cnpah.receivingStaff }}</td>
            </tr>
            <tr>
                <th>Letter_sender</th>
                <td>{{ cnpah.letterSender }}</td>
            </tr>
            <tr>
                <th>Office_designation</th>
                <td>{{ cnpah.officeDesignation }}</td>
            </tr>
            <tr>
                <th>Date_of_the_letter</th>
                <td>{{ cnpah.dateOfTheLetter ? cnpah.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Content_of_the_letter</th>
                <td>{{ cnpah.contentOfTheLetter }}</td>
            </tr>
            <tr>
                <th>Other_note</th>
                <td>{{ cnpah.otherNote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cnpahs_index') }}">back to list</a>

    <a href="{{ path('app_cnpahs_edit', {'id': cnpah.id}) }}">edit</a>

    {{ include('cnpahs/_delete_form.html.twig') }}
{% endblock %}
