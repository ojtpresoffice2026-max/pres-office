{% extends 'base.html.twig' %}

{% block title %}Caff{% endblock %}

{% block body %}
    <h1>Caff</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ caff.id }}</td>
            </tr>
            <tr>
                <th>No_of_comm</th>
                <td>{{ caff.noOfComm }}</td>
            </tr>
            <tr>
                <th>Document_code</th>
                <td>{{ caff.documentCode }}</td>
            </tr>
            <tr>
                <th>Bearer_of_letter</th>
                <td>{{ caff.bearerOfLetter }}</td>
            </tr>
            <tr>
                <th>Date_receive</th>
                <td>{{ caff.dateReceive ? caff.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Time_receive</th>
                <td>{{ caff.timeReceive }}</td>
            </tr>
            <tr>
                <th>Receiving_staff</th>
                <td>{{ caff.receivingStaff }}</td>
            </tr>
            <tr>
                <th>Letter_sender</th>
                <td>{{ caff.letterSender }}</td>
            </tr>
            <tr>
                <th>Office_designation</th>
                <td>{{ caff.officeDesignation }}</td>
            </tr>
            <tr>
                <th>Date_of_the_letter</th>
                <td>{{ caff.dateOfTheLetter ? caff.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Content_of_the_letter</th>
                <td>{{ caff.contentOfTheLetter }}</td>
            </tr>
            <tr>
                <th>Other_note</th>
                <td>{{ caff.otherNote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_caff_index') }}">back to list</a>

    <a href="{{ path('app_caff_edit', {'id': caff.id}) }}">edit</a>

    {{ include('caff/_delete_form.html.twig') }}
{% endblock %}
