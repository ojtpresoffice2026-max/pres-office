{% extends 'base.html.twig' %}

{% block title %}Cthm{% endblock %}

{% block body %}
    <h1>Cthm</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cthm.id }}</td>
            </tr>
            <tr>
                <th>No_of_comm</th>
                <td>{{ cthm.noOfComm }}</td>
            </tr>
            <tr>
                <th>Document_code</th>
                <td>{{ cthm.documentCode }}</td>
            </tr>
            <tr>
                <th>Bearer_of_letter</th>
                <td>{{ cthm.bearerOfLetter }}</td>
            </tr>
            <tr>
                <th>Date_receive</th>
                <td>{{ cthm.dateReceive ? cthm.dateReceive|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Time_receive</th>
                <td>{{ cthm.timeReceive }}</td>
            </tr>
            <tr>
                <th>Receiving_staff</th>
                <td>{{ cthm.receivingStaff }}</td>
            </tr>
            <tr>
                <th>Letter_sender</th>
                <td>{{ cthm.letterSender }}</td>
            </tr>
            <tr>
                <th>Office_designation</th>
                <td>{{ cthm.officeDesignation }}</td>
            </tr>
            <tr>
                <th>Date_of_the_letter</th>
                <td>{{ cthm.dateOfTheLetter ? cthm.dateOfTheLetter|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Content_of_the_letter</th>
                <td>{{ cthm.contentOfTheLetter }}</td>
            </tr>
            <tr>
                <th>Other_note</th>
                <td>{{ cthm.otherNote }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cthm_index') }}">back to list</a>

    <a href="{{ path('app_cthm_edit', {'id': cthm.id}) }}">edit</a>

    {{ include('cthm/_delete_form.html.twig') }}
{% endblock %}
